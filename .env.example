# Kopieer naar .env en pas aan voor productie.
SECRET_KEY=change-me-in-production
ADMIN_EMAIL=admin@teamplanning.nl
ADMIN_PASSWORD=changeme
# Gedeeld teamwachtwoord voor de naam-kiezer op het inlogscherm (wijzigbaar
# nadien via Beheer > Instellingen).
TEAM_ACCESS_PASSWORD=degouv

# Relatief pad (aanbevolen): de browser praat alleen met dit eigen origin,
# Next.js proxyt /api server-side naar de backend (zie
# frontend/next.config.mjs). Zet dit alleen op een volledige URL als de
# frontend en backend écht apart bereikbaar moeten zijn (bv. losse domeinen).
NEXT_PUBLIC_API_URL=/api

# Teambeheer-synchronisatie (zie README "Teambeheer synchroniseren")
TEAMBEHEER_AUTO_SYNC=true
TEAMBEHEER_SYNC_HOUR=3
TEAMBEHEER_SYNC_MINUTE=30
