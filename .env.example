# Kopieer naar .env en pas aan voor productie.
SECRET_KEY=change-me-in-production
ADMIN_EMAIL=admin@teamplanning.nl
ADMIN_PASSWORD=changeme
# Gedeeld teamwachtwoord voor de naam-kiezer op het inlogscherm (wijzigbaar
# nadien via Beheer > Instellingen).
TEAM_ACCESS_PASSWORD=degouv

# Poort op de host-machine waar de frontend-container op luistert. Alleen
# relevant als er een tweede, onafhankelijke instantie (bv. voor een ander
# team) op dezelfde machine draait — die moet dan een andere waarde krijgen
# (bv. 3001) om niet te botsen met deze. Anders gewoon op 3000 laten staan.
FRONTEND_PORT=3000

# Relatief pad (aanbevolen): de browser praat alleen met dit eigen origin,
# Next.js proxyt /api server-side naar de backend (zie
# frontend/next.config.mjs). Zet dit alleen op een volledige URL als de
# frontend en backend écht apart bereikbaar moeten zijn (bv. losse domeinen).
NEXT_PUBLIC_API_URL=/api

# Teambeheer-synchronisatie (zie README "Teambeheer synchroniseren")
TEAMBEHEER_AUTO_SYNC=true
TEAMBEHEER_SYNC_HOUR=3
TEAMBEHEER_SYNC_MINUTE=30

# Web Push (zie README "Pushmeldingen") — leeg laten betekent: push staat
# uit, de rest van de app werkt gewoon door. Sleutelpaar genereren: zie
# README voor het commando.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:info@degouv.nl
